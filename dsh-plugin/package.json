{
  "name": "dsh-cyber-im-avatar",
  "version": "0.19.0",
  "description": "IM 分身壳：在 DSH 侧边栏值守飞书 / 企业微信 / 钉钉的私聊与群聊，命中 @我 或新消息才唤醒绑定 DSH 会话，由 agent 按 skill 起草、调研并以本人身份回复；支持关注程度三态、新群自动分诊、按值班单点切换草稿审批 / 全自动发送，消息正文只留本机。",
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "prepack": "node scripts/bundle-skill.mjs",
    "test": "node --test",
    "build": "python3 scripts/build_client.py",
    "build:skill": "node scripts/bundle-skill.mjs",
    "migrate": "node scripts/migrate-state.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "skill",
    "cordis.patch.yml",
    "README.md",
    "scripts/migrate-state.mjs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "im",
    "feishu",
    "lark",
    "wecom",
    "dingtalk",
    "stand-in",
    "triage",
    "customer-service",
    "inbox"
  ],
  "author": "buger-gif",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buger-gif/cyber-im-avatar.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/buger-gif/cyber-im-avatar/tree/main/dsh-plugin",
  "bugs": {
    "url": "https://github.com/buger-gif/cyber-im-avatar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
